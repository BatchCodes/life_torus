# SPDX-License-Identifier: GPL-3.0-or-later
# Espressif ESP32-S3-DevKitC-1-N8R8: 8 MB flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Wi-Fi and the web server need more than the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# WebSocket for the phone app.
CONFIG_HTTPD_WS_SUPPORT=y

# 1 ms ticks for the display refresh timing.
CONFIG_FREERTOS_HZ=1000

# The log goes to the "UART" port. The "USB" port is the USB host for the controller.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
